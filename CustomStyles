-- Dragging PC + Mobile
local function makeDraggable(target, handle)
    local dragging = false
    local dragStart
    local startPos
    local dragInput

    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = target.Position
            dragInput = input

            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)

    UIS.InputChanged:Connect(function(input)
        if dragging and (
            input == dragInput or
            (dragInput.UserInputType == Enum.UserInputType.MouseButton1
            and input.UserInputType == Enum.UserInputType.MouseMovement)
        ) then
            local delta = input.Position - dragStart
            target.Position = UDim2.new(
                startPos.X.Scale,
                startPos.X.Offset + delta.X,
                startPos.Y.Scale,
                startPos.Y.Offset + delta.Y
            )
        end
    end)
end

makeDraggable(frame, title)
makeDraggable(open, open)

-- Script Toggle
local enabled = false

toggle.MouseButton1Click:Connect(function()
    if enabled then
        enabled = false
        toggle.Text = "OFF"
        toggle.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
        return
    end

    enabled = true
    toggle.Text = "ON"
    toggle.BackgroundColor3 = Color3.fromRGB(40, 170, 90)

    task.spawn(function()
        local success, err = pcall(function()
            loadstring(game:HttpGet(
                "https://raw.githubusercontent.com/Nightmareloil/Scripts/refs/heads/main/2026"
            ))()
        end)

        if not success then
            warn("Script error:", err)
            enabled = false
            toggle.Text = "OFF"
            toggle.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
        end
    end)
end)

-- Minimize
minimize.MouseButton1Click:Connect(function()
    open.Position = frame.Position
    frame.Visible = false
    open.Visible = true
end)

-- Reopen
open.MouseButton1Click:Connect(function()
    frame.Visible = true
    open.Visible = false
end)

-- Close GUI
close.MouseButton1Click:Connect(function()
    gui:Destroy()
end)
